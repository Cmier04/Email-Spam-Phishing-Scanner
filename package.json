{
  "name": "phislab-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop shell for PhishLab phishing education",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:dev": "node desktop/scripts/run-dev.mjs",
    "electron:dev": "npm run desktop:dev",
    "desktop:preview": "npm run build:web && electron . --preview",
    "build:web": "npm --prefix frontend run build",
    "test:desktop": "node --test desktop/tests/*.test.cjs",
    "backend:bundle": "python desktop/scripts/build_backend.py",
    "release:prepare": "node desktop/scripts/prepare-release.cjs",
    "pack:mac": "npm run build:web && npm run backend:bundle && npm run release:prepare && electron-builder --mac dmg --arm64",
    "pack:win": "npm run build:web && npm run backend:bundle && npm run release:prepare && electron-builder --win nsis --x64",
    "pack:linux": "npm run build:web && npm run backend:bundle && npm run release:prepare && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "edu.phislab.desktop",
    "productName": "PhishLab",
    "asar": true,
    "directories": {"output": "release"},
    "files": [
      "desktop/*.cjs",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {"from": "desktop/dist-backend/phislab-backend", "to": "backend", "filter": ["**/*"]},
      {"from": "desktop/release-assets/models", "to": "models", "filter": ["email_classifier.pkl", "summary-qwen.gguf"]},
      {"from": "desktop/release-assets/google", "to": "google", "filter": ["credentials.json"]}
    ],
    "mac": {"category": "public.app-category.education", "target": "dmg"},
    "win": {"target": "nsis"},
    "linux": {"category": "Education", "target": "AppImage"}
  }
}
